# Copia esto a video-ia/.env y rellena. .env esta en .gitignore: nunca se sube.
# Mientras este archivo no exista, el pipeline se niega a lanzar nada.

# --- claves ---
FAL_KEY=                    # fal.ai: Seedance 2.5 y 2.0, Nano Banana Pro, Seedream 5, Flux 2
OPENAI_API_KEY=             # GPT Image 2, para edicion y consistencia de personaje
HIGGSFIELD_MCP=0            # 1 si vas a usar Higgsfield por MCP para Soul ID / Elements

# --- presupuesto (el pipeline se para si lo supera) ---
MAX_USD_PER_RUN=15.00
MAX_USD_POR_JOB=1.50

# --- limites ---
MAX_JOBS_SIMULTANEOS=4
REINTENTOS=4

# --- calidad ---
PRUEBA_DURACION=6           # segundos del pase de prueba
PRUEBA_RESOLUCION=720p
FINAL_RESOLUCION=1080p
